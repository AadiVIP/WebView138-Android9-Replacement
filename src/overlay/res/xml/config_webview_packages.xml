<?xml version="1.0" encoding="utf-8"?>
<!-- RRO replacement for android:xml/config_webview_packages.
     An overlay REPLACES the target resource, it does not merge into it
     (ResourceTypes.cpp entry matching), so com.android.webview MUST stay listed:
     SystemImpl throws if no availableByDefault non-fallback provider remains
     (SystemImpl.java:112-146). Google WebView is listed FIRST because Android 9 selects
     the first valid availableByDefault provider in document order, with no sort
     (WebViewUpdater.java:261-277, :306-307).
     cert SHA-1   1F387CB25E0069EFCA490ADE28C060E09D37DD45
     cert SHA-256 6FAF3C4140407473400934D117815A21AF1CFEFC5C0BEE61C858BC3D72BA6FE5
     DER 959 bytes -> base64 1280 chars, single line (Base64.DEFAULT).
-->
<webviewproviders>
    <webviewprovider description="Google WebView" packageName="com.google.android.webview" availableByDefault="true">
        <signature></signature>
    </webviewprovider>
    <webviewprovider description="Android WebView" packageName="com.android.webview" availableByDefault="true">
    </webviewprovider>
</webviewproviders>
